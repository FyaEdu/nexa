-    {
-        $extension = trim(strtolower($extension), '. ');
-
-        if (! array_key_exists($extension, static::$mimes)) {
-            return null;
-        }
-
-        return is_array(static::$mimes[$extension]) ? static::$mimes[$extension][0] : static::$mimes[$extension];
-    }
-
-    /**
